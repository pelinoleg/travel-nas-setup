# Filebrowser — креды веб-морды (:8082). НЕ в git (секрет).
# setup.sh pre-seed'ит ими БД (config init + users add/update) ДО старта сервера,
# поэтому пароль детерминирован (а не случайный). Меняешь пароль здесь —
# перезапусти wizard `travel-nas-setup` с галкой FILEBROWSER: он обновит пароль
# admin'а в БД (users update). Дашборд (Services) показывает логин/пароль.
#
# ⚠️ Filebrowser монтирует /etc/travel-nas/ (секреты: токен бота, пароль NAS) —
# кто залогинится, видит их. Поставь нормальный пароль, не открывай :8082 наружу.

FB_USER="admin"
FB_PASS="changeme"
