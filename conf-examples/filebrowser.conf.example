# Filebrowser Quantum — креды веб-морды (:8082). НЕ в git (секрет).
# setup.sh пишет их в config.yaml стека (auth.adminPassword) — пароль
# детерминирован (в отличие от старого filebrowser со случайным паролем).
# Дашборд (Services) показывает логин/пароль.
#
# Пароль сидится при ПЕРВОМ старте (пустая БД). Сменить потом — в самой
# веб-морде (Settings), либо снести БД (/mnt/storage/_appdata/filebrowser-quantum)
# и перезапустить wizard `travel-nas-setup`.
#
# ⚠️ Filebrowser монтирует /etc/travel-nas/ (секреты: токен бота, пароль NAS) —
# кто залогинится, видит их. Поставь нормальный пароль, не открывай :8082 наружу.

FB_USER="admin"
FB_PASS="changeme"
