# Filebrowser — креды веб-морды (:8082). Этот файл НЕ в git (секрет).
# Скопировать в /etc/travel-nas/filebrowser.conf, права 600.
#
# ⚠️ Filebrowser монтирует ВЕСЬ /etc/travel-nas/ (вкл. секреты: токен бота,
# пароль NAS). Любой, кто залогинится сюда — видит их. Поставь нормальный
# пароль (НЕ переиспользуй login/sudo пароль) и не открывай порт наружу.

FB_USER=""          # пусто = юзер из uid 1000 (тот, что задан в Pi Imager)
FB_PASS="changeme"  # ОБЯЗАТЕЛЬНО смени
