# /etc/travel-nas/webdash.conf — настройки веб-дашборда (DSI).
# Применяется при рестарте travel-nas-webdash.service.
PORT=8090
# BIND: 0.0.0.0 = открыт по сети (http://<host>.local:8090), 127.0.0.1 = только
# локально (kiosk). По умолчанию открыт — это личный travel-NAS. ВНИМАНИЕ:
# дашборд БЕЗ пароля — reboot/выключение/правка конфигов доступны всем в сети.
# В общей сети (отель) поставь 127.0.0.1.
BIND=0.0.0.0
STREAM_SEC=2
SAMPLE_SEC=30
HISTORY_DB=/mnt/storage/.travel-nas/metrics.db
STORAGE_MOUNT=/mnt/storage
