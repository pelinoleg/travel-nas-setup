# /etc/travel-nas/webdash.conf — настройки веб-дашборда (DSI).
# Применяется при рестарте travel-nas-webdash.service.
PORT=8090
# BIND: 127.0.0.1 = только локально (kiosk). 0.0.0.0 = открыть по сети
# (http://<host>.local:8090). ВНИМАНИЕ: дашборд без пароля — reboot/правка
# конфигов доступны всем в сети. Включай только в доверенной сети.
BIND=127.0.0.1
STREAM_SEC=2
SAMPLE_SEC=30
HISTORY_DB=/mnt/storage/.travel-nas/metrics.db
STORAGE_MOUNT=/mnt/storage
